{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_GAP_PREVIEW": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://diaspora-api.fly.dev/v1"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://diaspora-api.fly.dev/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

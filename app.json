{
  "expo": {
    "name": "Diaspora-app",
    "slug": "diasporaos",
    "version": "1.0.1",
    "scheme": "diaspora",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.diaspora.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "diaspora-api.fly.dev", "pathPrefix": "/payments/checkout" },
            { "scheme": "https", "host": "diaspora-api.fly.dev", "pathPrefix": "/email/confirm" },
            { "scheme": "https", "host": "diaspora-api.fly.dev", "pathPrefix": "/open" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Diaspora uses your location to confirm the country you live in when you join, and to show you services nearby."
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyCalendarPermission": "Diaspora adds the events you choose to your calendar. It does not read your other events.",
          "calendarPermission": "Diaspora adds the events you choose to your calendar, and checks whether it already added one so it does not add it twice."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59300",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-loopback-cleartext"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9cf15b0-d792-40e1-930a-c57fd7808437"
      }
    },
    "owner": "joshdias"
  }
}
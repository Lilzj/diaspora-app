# Diaspora Platform — npm configuration
#
# `legacy-peer-deps` is set for one specific, unavoidable conflict, and is
# documented here so nobody has to rediscover it:
#
#   jest-expo@57.0.3   peer         @react-native/jest-preset@^0.86.2
#   react-native@0.86.0 peerOptional @react-native/jest-preset@0.86.0
#
# No version satisfies both. React Native's is `peerOptional` and jest-expo's is
# a hard peer, so the tree installs 0.86.2 — which is correct — and npm's strict
# peer resolver refuses it anyway because it checks optional peers too.
#
# Without this, `npm ci` fails and EAS Build dies in the "Install dependencies"
# phase. `npm install` locally masks it, which is why the first cloud build
# after the test tooling landed was the first place it showed up.
#
# Expo SDK 57 pins react-native to 0.86.0, so bumping React Native to match
# jest-expo is not an option — it would break the SDK alignment. Revisit when
# either Expo SDK 58 or a jest-expo release relaxes the range.
legacy-peer-deps=true
